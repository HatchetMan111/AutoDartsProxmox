[Unit]
Description=AutoDarts Proxmox Manager Web-UI (Port @MANAGER_PORT@)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=MANAGER_PORT=@MANAGER_PORT@
Environment=BOARD_PORT=@BOARD_PORT@
Environment=CALLER_PORT=@CALLER_PORT@
Environment=DARTS_HUB_DIR=@DARTS_HUB_DIR@
ExecStart=/usr/bin/python3 @MANAGER_DIR@/manager.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
